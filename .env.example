# API Configuration
VITE_API_BASE_URL=https://api.production.com

# Vite dev: HTTP by default (`npm run dev`). Set Billing__MoMo__RedirectUrl to http://localhost:5173/...
# HTTPS (self-signed): npm run dev:https  → RedirectUrl must be https://localhost:5173/...
# VITE_DEV_HTTPS=1

# App Configuration
VITE_APP_NAME=CAMS
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true

# External Services
VITE_SENTRY_DSN=
VITE_GA_TRACKING_ID=